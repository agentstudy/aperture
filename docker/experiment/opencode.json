{
  "$schema": "https://opencode.ai/config.json",
  "model": "anthropic/claude-sonnet-5-5",
  "small_model": "anthropic/claude-haiku-5-5",
  "agent": {
    "explore": {
      "model": "anthropic/claude-haiku-5-5"
    }
  },
  "autoupdate": false,
  "share": "disabled",
  "permission": {
    "bash": {
      "*": "allow",
      "git *": "deny",
      "git status *": "allow",
      "git diff": "allow",
      "git diff --stat": "allow",
      "git diff -- *": "allow",
      "gh *": "deny",
      "curl *": "deny",
      "wget *": "deny",
      "curl *localhost*": "allow",
      "curl *127.0.0.1*": "allow",
      "wget *localhost*": "allow",
      "wget *127.0.0.1*": "allow",
      "sudo *": "deny",
      "chmod -R *": "deny",
      "chown -R *": "deny",
      "rm -rf /*": "deny",
      "rm -rf ~*": "deny",
      "rm -rf $HOME*": "deny",
      "rm -rf ..*": "deny",
      "rm -fr /*": "deny",
      "rm -fr ~*": "deny",
      "rm -fr ..*": "deny",
      "rm -rf /tmp/*": "allow",
      "sh": "deny",
      "bash": "deny"
    },
    "external_directory": {
      "*": "allow",
      "/workspaces/.study/*": "deny",
      "/workspaces/.codespaces/*": "deny"
    },
    "edit": {
      "*": "allow",
      "../*": "deny"
    },
    "webfetch": "deny",
    "websearch": "deny"
  }
}
