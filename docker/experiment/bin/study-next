#!/usr/bin/env bash
# Move from the warm-up to the main task in the same codespace: `study-next`.
#   1. close the tool and the dev server
#   2. save the warm-up locally on branch study-warmup (not pushed; study-submit pushes it at the end)
#   3. switch to the clean main-task branch (the warm-up branch minus "-warmup"), keeping .venv and
#      node_modules, so nothing is reinstalled
#   4. reset the demo DB and restart the dev server, recording into the main-task record
#   5. write <base>/<repo>/switched; the study logger then closes the warm-up's editors, opens the
#      main TASK-README.md and restarts the tool on the right
# Safe to rerun if it stops partway.
set -euo pipefail
. /opt/study/bin/study-lib.sh
die() { echo; echo "ERROR: $*" >&2; echo "Please tell the facilitator." >&2; exit 1; }

repo=$(repo_root); cd "$repo"
name=$(basename "$repo")
dir=$(study_base)/$name
[ "$(repo_phase "$name")" = warmup ] || die "this codespace is already on the main task."

cur=$(git branch --show-current)
if [ "$cur" = study-warmup ]; then
  main=$(cat "$dir/next-branch" 2>/dev/null) || die "found a saved warm-up but not the main-task branch name."
elif [[ "$cur" == *-warmup ]]; then
  main=${cur%-warmup}
else
  die "expected a warm-up branch, found '$cur'."
fi

read -r -p "Finish the warm-up and start the main task? This closes the coding assistant. [y/N] " answer </dev/tty || answer=
[[ "$answer" =~ ^[Yy] ]] || { echo "Still on the warm-up."; exit 1; }

git fetch -q origin "$main" || die "could not fetch the main task ($main)."
if [ "$cur" != study-warmup ]; then
  echo "$main" > "$dir/next-branch"
  stop_tool
  /opt/study/bin/study-capture --local study-warmup || die "could not save the warm-up."
fi

echo "Switching to the main task..."
git checkout -q -f -B "$main" "origin/$main"
git clean -q -fd   # untracked files only; ignored ones (.venv, node_modules, the demo DB) stay
echo main > "$dir/phase"
make reset-db >/dev/null 2>&1 || die "make reset-db failed."
/opt/study/bin/study-start
echo
echo "The main task is ready. Its instructions are in TASK-README.md, and the coding assistant is"
echo "restarting on the right. Your warm-up has been saved."
date -Is > "$dir/switched"
