#!/usr/bin/env bash
# postStartCommand: start `make dev` detached, on every container start. Output goes to the session
# record. Never exits non-zero and never reseeds, so restarting a codespace keeps the session's data.
set -uo pipefail
. /opt/study/bin/study-lib.sh
repo=$(repo_root)
rec=$(record_dir "$(basename "$repo")") || exit 0
pid=$(cat "$rec/dev-server.pid" 2>/dev/null || true)
if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then exit 0; fi
rm -f "$rec/dev-server.pid"
cd "$repo" || exit 0
# setsid -f, because Codespaces kills a hook's background children when the hook returns.
# Each line is prefixed with a UTC timestamp so API requests can be placed on the session timeline.
setsid -f bash -c 'echo $$ > "$1"; make dev 2>&1 | python3 -u /opt/study/bin/study-ts' _ "$rec/dev-server.pid" >> "$rec/dev-server.log" 2>&1 < /dev/null
for _ in $(seq 60); do
  [ "$(curl -s -o /dev/null -w '%{http_code}' http://localhost:5173/)" = 200 ] && break
  sleep 1
done
exit 0
